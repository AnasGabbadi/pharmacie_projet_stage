# Port d'écoute du serveur Express
PORT=

# URL de connexion MongoDB (Mongoose) - ex: mongodb://127.0.0.1:27017/nom_de_la_base
DATABASE_URL=

# Secret utilisé pour signer les tokens JWT — générer une valeur aléatoire forte,
# ne jamais commiter la vraie valeur
JWT_SECRET=

# URL de base publique du backend, utilisée pour construire les URLs d'images
# (optionnel : déduite de la requête si absente) - ex: http://localhost:3000
BASE_URL=

# Environnement d'exécution - development | production
NODE_ENV=

# Compte Gmail utilisé pour l'envoi des emails transactionnels (Nodemailer,
# SMTP Gmail) - EMAIL_PASSWORD doit être un mot de passe d'application Gmail,
# pas le mot de passe du compte
EMAIL_USER=
EMAIL_PASSWORD=
